<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>IndexingDialog</class>
 <widget class="QDialog" name="IndexingDialog">
  <property name="windowTitle"><string>Indexing Parameters</string></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLabel" name="instructions">
    <property name="text"><string>Search for crystal orientations using the selected spots. All matched hkl must fall within the ranges below.</string></property>
    <property name="wordWrap"><bool>true</bool></property>
    <property name="minimumSize"><size><width>380</width><height>0</height></size></property>
   </widget></item>
   <item><layout class="QGridLayout" name="parameters">
    <item row="0" column="1"><widget class="QLabel" name="hLabel"><property name="text"><string>H</string></property></widget></item>
    <item row="0" column="2"><widget class="QLabel" name="kLabel"><property name="text"><string>K</string></property></widget></item>
    <item row="0" column="3"><widget class="QLabel" name="lLabel"><property name="text"><string>L</string></property></widget></item>
    <item row="1" column="0"><widget class="QLabel" name="rangeLabel"><property name="text"><string>Maximum |hkl|</string></property></widget></item>
    <item row="1" column="1"><widget class="QLineEdit" name="maxH"/></item>
    <item row="1" column="2"><widget class="QLineEdit" name="maxK"/></item>
    <item row="1" column="3"><widget class="QLineEdit" name="maxL"/></item>
    <item row="2" column="0"><widget class="QLabel" name="angleLabel"><property name="text"><string>Angular tolerance (deg)</string></property></widget></item>
    <item row="2" column="1" colspan="3"><widget class="QLineEdit" name="angTol"/></item>
    <item row="3" column="0"><widget class="QLabel" name="spotLabel"><property name="text"><string>Spot tolerance (mm)</string></property></widget></item>
    <item row="3" column="1" colspan="3"><widget class="QLineEdit" name="spotAccuracy"/></item>
   </layout></item>
   <item><widget class="QLabel" name="help">
    <property name="text"><string>The first two spots define each candidate; additional spots test it. Results are ranked by matched spots, then RMS position error. Review a candidate before applying it.</string></property>
    <property name="wordWrap"><bool>true</bool></property>
   </widget></item>
   <item><widget class="QDialogButtonBox" name="buttonBox">
    <property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property>
   </widget></item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection><sender>buttonBox</sender><signal>accepted()</signal><receiver>IndexingDialog</receiver><slot>accept()</slot></connection>
  <connection><sender>buttonBox</sender><signal>rejected()</signal><receiver>IndexingDialog</receiver><slot>reject()</slot></connection>
 </connections>
</ui>
